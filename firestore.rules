rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Permite leer a usuarios autenticados (tu móvil, tu PC)
      allow read: if request.auth != null;
      
      // Permite escribir solo si el usuario está autenticado
      allow write: if request.auth != null && (request.auth.token.email == "coler888@gmail.com" || request.auth.token.email == "samuelsanchezpas@gmail.com");
    }
  }
}